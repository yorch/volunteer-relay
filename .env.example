DATABASE_URL=postgres://relay:relay@localhost:5432/relay
# Explicit separate test database; create it before integration checks. Never use DATABASE_URL for test resets.
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test
APP_URL=http://localhost:3000
# Required before production auth configuration; generate a random 32+ character value.
# BETTER_AUTH_SECRET=
ATTACHMENT_ROOT=/data/attachments
# Private attachment bytes: "filesystem" (default, needs ATTACHMENT_ROOT) or
# "s3" for any S3-compatible service. S3 mode is fail-closed: an incomplete or
# plaintext-endpoint configuration refuses to start instead of falling back to
# local disk.
BLOB_STORE=filesystem
# S3_BUCKET=relay-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=https://objects.example.invalid
# S3_PREFIX=relay/attachments
# Stable per-deployment identifier. Shares a bucket with no other deployment;
# a mismatch refuses to write.
# S3_DEPLOYMENT_ID=relay-prod-01
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required for endpoints that do not resolve virtual-host buckets (most local
# and single-host services, including versitygw).
# S3_FORCE_PATH_STYLE=true
# "unversioned" refuses buckets where a delete leaves the bytes behind.
# S3_ERASURE_MODE=unversioned
# Orphan reconciliation age floor in ms; hygiene only, never delete safety.
# S3_RECONCILE_MINIMUM_AGE_MS=3600000
# Allow a plaintext endpoint in development. Rejected in production.
# S3_ALLOW_INSECURE=false
DEMO_MODE=false
LOG_LEVEL=info
# OPENAI_MODEL=choose-after-fixture-evaluation
OPENAI_MONTHLY_BUDGET_CENTS=0
TELEGRAM_TRANSPORT=replay
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_FROM=relay@example.invalid
ATTACHMENT_MAX_BYTES=10485760
# Optional secrets: OPENAI_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
# SMTP_USER, SMTP_PASSWORD. Leave unset until their adapter task is configured.
# Optional local Compose host ports; defaults shown.
RELAY_POSTGRES_PORT=5432
RELAY_WEB_PORT=3000
RELAY_MAILPIT_UI_PORT=8025
RELAY_SMTP_PORT=1025
# Required trusted pricing and maximum accepted model input before extraction enables.
# Prices are integer micro-US dollars per million tokens; obtain current provider rates.
# Set the input bound to the model's accepted maximum input, including images/schema.
# OPENAI_INPUT_MICROUSD_PER_MILLION=
# OPENAI_OUTPUT_MICROUSD_PER_MILLION=
# OPENAI_INPUT_TOKEN_LIMIT=
OPENAI_OUTPUT_TOKEN_LIMIT=6000
# Required for photos: documented maximum input tokens per low-detail image for the chosen model.
# OPENAI_IMAGE_INPUT_TOKEN_LIMIT=
# Source-scoped retention ledger signing key; generate securely, never commit a value.
# RETENTION_LEDGER_KEY=
