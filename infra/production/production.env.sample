# Operator environment for compose.production.yaml.
#
# Install it, then replace every REPLACE_* placeholder:
#
#   install -d -m 0700 /etc/volunteer-relay
#   install -m 0600 infra/production/production.env.sample /etc/volunteer-relay/production.env
#   $EDITOR /etc/volunteer-relay/production.env
#   docker compose --project-name "$COMPOSE_PROJECT_NAME" \
#     --env-file /etc/volunteer-relay/production.env -f compose.production.yaml config --quiet
#
# Compose interpolates this file. The web and worker containers do not read it:
# they receive infra/production/runtime.env.sample instead, via
# RELAY_RUNTIME_ENV_FILE. Never commit a filled copy of either file; the values
# below are placeholders, not credentials.

# --- Compose project -------------------------------------------------------
# One name per deployment. It prefixes networks, volumes and container names,
# and it is what backup.sh and restore.sh are pointed at.
COMPOSE_PROJECT_NAME=volunteer-relay-prod

# --- PostgreSQL bootstrap identity ----------------------------------------
# The owner that runs migrations. The Postgres image only applies these to a
# new volume; editing the file later does not rotate an existing cluster.
POSTGRES_USER=relay
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
POSTGRES_DB=relay
MIGRATION_DATABASE_URL=postgres://relay:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@postgres:5432/relay

# --- Application runtime identity -----------------------------------------
# Must be a distinct role with no owned objects and no role memberships; the
# runtime-grants gate creates it and grants CRUD on public tables only.
RELAY_RUNTIME_USER=relay_app
RELAY_RUNTIME_PASSWORD=REPLACE_WITH_A_DIFFERENT_URL_SAFE_RANDOM_PASSWORD
RELAY_RUNTIME_ENV_FILE=/etc/volunteer-relay/runtime.env

# --- Ingress ---------------------------------------------------------------
# The host Traefik already owns 80/443, TLS and certificate state. This stack
# publishes no ports and declares one router; RELAY_DOMAIN must match the DNS
# record and the certificate the host proxy issues.
RELAY_DOMAIN=relay.example.org
# Optional. Scopes the router, service and compression middleware names on the
# shared proxy. Change it when another stack on the same host already claims
# `relay`: two routers sharing a name make Traefik drop both.
TRAEFIK_NAME=relay

# --- Images ----------------------------------------------------------------
# Pin the digests published by the release job. Both images must come from the
# same reviewed commit; never deploy a moving tag.
RELAY_WEB_IMAGE=ghcr.io/yorch/volunteer-relay-web@sha256:REPLACE
RELAY_WORKER_IMAGE=ghcr.io/yorch/volunteer-relay-worker@sha256:REPLACE
