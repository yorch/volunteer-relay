# Runtime environment for the web and worker containers.
#
#   install -m 0600 infra/production/runtime.env.sample /etc/volunteer-relay/runtime.env
#   $EDITOR /etc/volunteer-relay/runtime.env
#
# Compose mounts this file into web and worker through RELAY_RUNTIME_ENV_FILE
# in the operator environment. It is never read by Compose itself, so a typo
# here fails inside the container rather than at deploy time. The database and
# mail credentials in it are different from the ones in production.env.
#
# Secrets are commented out on purpose. With NODE_ENV=production the
# application refuses to start unless BETTER_AUTH_SECRET is set to at least 32
# characters and DEMO_MODE is false, so a blind copy of this file fails loudly
# instead of booting with a placeholder secret. Generate values with
# `openssl rand -hex 32` and keep them in the secret manager, not in Git.

NODE_ENV=production
DEMO_MODE=false
LOG_LEVEL=info
APP_URL=https://relay.example.org
ATTACHMENT_ROOT=/data/attachments
ATTACHMENT_MAX_BYTES=10485760

# --- Private attachment storage --------------------------------------------
# filesystem keeps bytes on the ATTACHMENT_ROOT volume; s3 puts them in any
# S3-compatible bucket. S3 configuration is fail-closed: an incomplete config or
# a plaintext endpoint refuses to start rather than falling back to local disk.
BLOB_STORE=filesystem
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://objects.example.org
# S3_PREFIX=relay/attachments
# Stable per-deployment identifier. Never share a bucket or prefix between
# deployments: a mismatch refuses to write, and two deployments would otherwise
# sweep each other's objects.
# S3_DEPLOYMENT_ID=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Required when the endpoint does not resolve virtual-host buckets.
# S3_FORCE_PATH_STYLE=true
# unversioned refuses buckets where a delete leaves the bytes behind; set
# "versions" only when the bucket is versioned and the runtime role may delete
# every version.
# S3_ERASURE_MODE=unversioned
# S3_RECONCILE_MINIMUM_AGE_MS=3600000
# Only for a plaintext endpoint in development; production always requires https.
# S3_ALLOW_INSECURE=false
# Cutover only. While set, reads fall back to this frozen volume, writes go to
# the bucket, and erasure covers both stores. Remove it and delete the volume
# together after verification: kept any longer, erasure is only bucket-deep.
# BLOB_FALLBACK_ROOT=/data/attachments

# Runtime role, not the migration owner. Must match RELAY_RUNTIME_USER and
# RELAY_RUNTIME_PASSWORD in production.env.
DATABASE_URL=postgres://relay_app:REPLACE_WITH_A_DIFFERENT_URL_SAFE_RANDOM_PASSWORD@postgres:5432/relay

# --- Required secrets ------------------------------------------------------
# Session signing key; at least 32 characters. Production refuses to start
# without it. Rotating it signs everyone out.
# BETTER_AUTH_SECRET=
# Signs the retention/redaction ledger; at least 32 characters. The app still
# starts without it, but ledger export and redaction answer
# DEPENDENCY_UNAVAILABLE. Must be stable across upgrades and backed up
# separately from the database: a lost key makes ledger replay impossible.
# RETENTION_LEDGER_KEY=

# --- Outbound mail ---------------------------------------------------------
SMTP_HOST=mail.example.org
SMTP_PORT=465
SMTP_TLS=true
SMTP_FROM=relay@example.org
# SMTP_USER=
# SMTP_PASSWORD=

# --- Optional providers ----------------------------------------------------
# Extraction stays disabled until a model, its prices and its input bound are
# all configured. Prices are integer micro-US-dollars per million tokens.
# TELEGRAM_TRANSPORT defaults to replay, which sends nothing.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_INPUT_MICROUSD_PER_MILLION=
# OPENAI_OUTPUT_MICROUSD_PER_MILLION=
# OPENAI_INPUT_TOKEN_LIMIT=
# OPENAI_IMAGE_INPUT_TOKEN_LIMIT=
# OPENAI_OUTPUT_TOKEN_LIMIT=6000
# OPENAI_MONTHLY_BUDGET_CENTS=0
# TELEGRAM_TRANSPORT=replay
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
