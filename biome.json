{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!.claude",
      "!**/.next-video",
      "!**/dist",
      "!**/next-env.d.ts",
      "!bun.lock",
      "!video/generated",
      "!video/output",
      "!video/.auth",
      "!IMPLEMENTATION-PLAN.md",
      "!design/reference/prototype.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
