{
  "name": "volunteer-relay",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": "26.11.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "video"
  ],
  "scripts": {
    "agents": "node scripts/agents.mjs",
    "agents:dashboard": "node scripts/crewplane.mjs dashboard",
    "agents:supervisor": "node scripts/crewplane.mjs",
    "agents:watch": "node scripts/crewplane.mjs monitor",
    "blob:migrate": "node scripts/blob-migrate.ts",
    "build": "node scripts/run.mjs build",
    "check": "node node_modules/@biomejs/biome/bin/biome check .",
    "db:migrate": "node packages/db/src/migrate.ts",
    "db:seed": "node packages/db/src/seed.ts",
    "db:seed:demo": "node scripts/seed-demo.ts --demo",
    "dev": "node scripts/run.mjs dev",
    "dev:web": "node scripts/run.mjs web",
    "dev:worker": "node --watch apps/worker/src/index.ts",
    "format": "node node_modules/@biomejs/biome/bin/biome check --write .",
    "s3:bootstrap": "node scripts/s3-bootstrap.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node node_modules/@playwright/test/cli.js install chromium",
    "test:integration": "node node_modules/vitest/vitest.mjs run --config packages/db/vitest.integration.config.ts",
    "test:live-provider": "node scripts/live-provider-smoke.ts",
    "test:product:integration": "node scripts/product-integration.mjs",
    "typecheck": "node scripts/run.mjs typecheck",
    "verify": "node scripts/run.mjs verify",
    "video:auth": "node video/scripts/auth.ts",
    "video:auth:clear": "node video/scripts/auth-clear.ts",
    "video:capture": "node video/scripts/capture.ts",
    "video:doctor": "node video/scripts/doctor.ts",
    "video:prepare": "node video/scripts/prepare.ts",
    "video:preview": "node video/scripts/preview.ts",
    "video:proof": "node video/scripts/render.ts --proof",
    "video:provision": "node video/scripts/provision.ts",
    "video:render": "node video/scripts/render.ts",
    "video:test": "node node_modules/vitest/vitest.mjs run video",
    "video:timeline": "node video/scripts/timeline.ts",
    "video:typecheck": "node node_modules/typescript/bin/tsc -p video/tsconfig.json",
    "video:validate": "node video/scripts/validate.ts",
    "video:verify": "node node_modules/@biomejs/biome/bin/biome check video && node node_modules/typescript/bin/tsc -p video/tsconfig.json && node node_modules/vitest/vitest.mjs run video",
    "video:voice": "node video/scripts/voice.ts",
    "crewplane": "node scripts/crewplane.mjs",
    "agents:watchdog": "node scripts/crewplane.mjs watchdog",
    "agents:evidence": "node scripts/crewplane.mjs evidence"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1019.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "type": "module"
}
