{
  "schemaVersion": 1,
  "scenes": [
    {
      "sceneId": "S01",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.3591401393442624,
          "text": "A volunteer spends an hour mentoring a"
        },
        {
          "startSeconds": 2.3591401393442624,
          "endSeconds": 2.731635950819672,
          "text": "child."
        },
        {
          "startSeconds": 2.731635950819672,
          "endSeconds": 5.214941360655738,
          "text": "Before she leaves, she learns the family"
        },
        {
          "startSeconds": 5.214941360655738,
          "endSeconds": 7.884494676229508,
          "text": "needs diapers tonight, so she posts a brief"
        },
        {
          "startSeconds": 7.884494676229508,
          "endSeconds": 8.319073122950819,
          "text": "update."
        },
        {
          "startSeconds": 8.319073122950819,
          "endSeconds": 10.740295897540983,
          "text": "By morning it is buried under dozens of"
        },
        {
          "startSeconds": 10.740295897540983,
          "endSeconds": 11.299039614754099,
          "text": "messages."
        },
        {
          "startSeconds": 11.299039614754099,
          "endSeconds": 13.161518672131148,
          "text": "The hour may never be counted."
        },
        {
          "startSeconds": 13.161518672131148,
          "endSeconds": 15.148163,
          "text": "The family may still be waiting."
        }
      ]
    },
    {
      "sceneId": "S02",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.67514867961165,
          "text": "This is the problem behind challenge five:"
        },
        {
          "startSeconds": 2.67514867961165,
          "endSeconds": 5.41399137540453,
          "text": "coordinators rebuild their week from chats,"
        },
        {
          "startSeconds": 5.41399137540453,
          "endSeconds": 8.21652808737864,
          "text": "texts and photos — forty volunteers, roughly"
        },
        {
          "startSeconds": 8.21652808737864,
          "endSeconds": 10.82798275080906,
          "text": "four hours a week, reconstructed by hand."
        },
        {
          "startSeconds": 10.82798275080906,
          "endSeconds": 13.375743398058251,
          "text": "Volunteer Relay turns those updates into"
        },
        {
          "startSeconds": 13.375743398058251,
          "endSeconds": 16.0508920776699,
          "text": "traceable records, and needs someone owns."
        },
        {
          "startSeconds": 16.0508920776699,
          "endSeconds": 18.85342878964401,
          "text": "Here is the coordinator's inbox, with review"
        },
        {
          "startSeconds": 18.85342878964401,
          "endSeconds": 19.681450999999996,
          "text": "work waiting."
        }
      ]
    },
    {
      "sceneId": "S03",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.233363300724638,
          "text": "Volunteers report in their own words."
        },
        {
          "startSeconds": 2.233363300724638,
          "endSeconds": 4.587448942028986,
          "text": "This update describes one shared garden"
        },
        {
          "startSeconds": 4.587448942028986,
          "endSeconds": 7.182979264492754,
          "text": "visit, two volunteers, and the time each of"
        },
        {
          "startSeconds": 7.182979264492754,
          "endSeconds": 7.786590967391305,
          "text": "them gave."
        },
        {
          "startSeconds": 7.786590967391305,
          "endSeconds": 9.838870757246378,
          "text": "Relay proposes an activity and two"
        },
        {
          "startSeconds": 9.838870757246378,
          "endSeconds": 12.192956398550725,
          "text": "contributions, and keeps every proposed"
        },
        {
          "startSeconds": 12.192956398550725,
          "endSeconds": 14.305597358695653,
          "text": "field tied to the original message."
        },
        {
          "startSeconds": 14.305597358695653,
          "endSeconds": 16.659683,
          "text": "Nothing is approved until staff decide."
        }
      ]
    },
    {
      "sceneId": "S04",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.420695632996633,
          "text": "One message holds a visit for two people."
        },
        {
          "startSeconds": 2.420695632996633,
          "endSeconds": 4.723308552188552,
          "text": "One shared hour means one visit and two"
        },
        {
          "startSeconds": 4.723308552188552,
          "endSeconds": 7.321128255892256,
          "text": "volunteer-hours, so approving it records two"
        },
        {
          "startSeconds": 7.321128255892256,
          "endSeconds": 9.623741175084175,
          "text": "separate contributions of sixty minutes"
        },
        {
          "startSeconds": 9.623741175084175,
          "endSeconds": 9.91894795959596,
          "text": "each."
        },
        {
          "startSeconds": 9.91894795959596,
          "endSeconds": 12.339643592592592,
          "text": "Staff can inspect the evidence first, and"
        },
        {
          "startSeconds": 12.339643592592592,
          "endSeconds": 14.937463296296297,
          "text": "anything missing or unresolved stays visible"
        },
        {
          "startSeconds": 14.937463296296297,
          "endSeconds": 16.41349721885522,
          "text": "instead of being guessed."
        },
        {
          "startSeconds": 16.41349721885522,
          "endSeconds": 17.535283,
          "text": "Nothing is guessed."
        }
      ]
    },
    {
      "sceneId": "S05",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.331187731092437,
          "text": "A later update describes the same visit."
        },
        {
          "startSeconds": 2.331187731092437,
          "endSeconds": 4.662375462184874,
          "text": "Counting every message would inflate the"
        },
        {
          "startSeconds": 4.662375462184874,
          "endSeconds": 6.760444420168067,
          "text": "totals, so Relay raises the possible"
        },
        {
          "startSeconds": 6.760444420168067,
          "endSeconds": 8.333996138655461,
          "text": "duplicate for staff review."
        },
        {
          "startSeconds": 8.333996138655461,
          "endSeconds": 10.606904176470588,
          "text": "Rejecting it leaves the approved ledger"
        },
        {
          "startSeconds": 10.606904176470588,
          "endSeconds": 13.054651294117647,
          "text": "unchanged, and the decision stays attached"
        },
        {
          "startSeconds": 13.054651294117647,
          "endSeconds": 13.870567,
          "text": "to its source."
        }
      ]
    },
    {
      "sceneId": "S06",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.6420867314285714,
          "text": "An urgent need should never wait on a buried"
        },
        {
          "startSeconds": 2.6420867314285714,
          "endSeconds": 3.1224661371428573,
          "text": "message."
        },
        {
          "startSeconds": 3.1224661371428573,
          "endSeconds": 5.764552868571428,
          "text": "Staff assign an owner, set an acknowledgment"
        },
        {
          "startSeconds": 5.764552868571428,
          "endSeconds": 8.10640247142857,
          "text": "deadline, and later record the outcome."
        },
        {
          "startSeconds": 8.10640247142857,
          "endSeconds": 10.268109797142856,
          "text": "If acknowledgment stalls, the worker"
        },
        {
          "startSeconds": 10.268109797142856,
          "endSeconds": 11.829342865714285,
          "text": "escalates at the deadline."
        },
        {
          "startSeconds": 11.829342865714285,
          "endSeconds": 14.171192468571427,
          "text": "Delivery is not acknowledgment, and the"
        },
        {
          "startSeconds": 14.171192468571427,
          "endSeconds": 16.51304207142857,
          "text": "board shows what still needs attention."
        },
        {
          "startSeconds": 16.51304207142857,
          "endSeconds": 18.674749397142854,
          "text": "An acknowledgment is a person taking"
        },
        {
          "startSeconds": 18.674749397142854,
          "endSeconds": 21.016598999999996,
          "text": "responsibility, not a provider receipt."
        }
      ]
    },
    {
      "sceneId": "S07",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.5127245647058825,
          "text": "At the end of the week the report comes from"
        },
        {
          "startSeconds": 2.5127245647058825,
          "endSeconds": 4.797019623529412,
          "text": "the same records the team used to do its"
        },
        {
          "startSeconds": 4.797019623529412,
          "endSeconds": 5.082556505882353,
          "text": "work."
        },
        {
          "startSeconds": 5.082556505882353,
          "endSeconds": 7.423958941176471,
          "text": "Approved hours, contributions, open needs"
        },
        {
          "startSeconds": 7.423958941176471,
          "endSeconds": 9.879576129411765,
          "text": "and pending items are counted consistently,"
        },
        {
          "startSeconds": 9.879576129411765,
          "endSeconds": 12.278085941176471,
          "text": "and unknown time stays unknown rather than"
        },
        {
          "startSeconds": 12.278085941176471,
          "endSeconds": 13.077589211764707,
          "text": "becoming zero."
        },
        {
          "startSeconds": 13.077589211764707,
          "endSeconds": 15.476099023529413,
          "text": "Every decision is kept in an audit history"
        },
        {
          "startSeconds": 15.476099023529413,
          "endSeconds": 17.93171621176471,
          "text": "with its source, so the report and the work"
        },
        {
          "startSeconds": 17.93171621176471,
          "endSeconds": 19.416508,
          "text": "share one source of truth."
        }
      ]
    },
    {
      "sceneId": "S08",
      "derived": "proportional-phrase",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 1.0094826218487394,
          "text": "Volunteer Relay."
        },
        {
          "startSeconds": 1.0094826218487394,
          "endSeconds": 3.5962818403361343,
          "text": "Every hour counted, every need connected."
        },
        {
          "startSeconds": 3.5962818403361343,
          "endSeconds": 6.183081058823529,
          "text": "Built for nonprofit teams, with fictional"
        },
        {
          "startSeconds": 6.183081058823529,
          "endSeconds": 8.959158268907562,
          "text": "demo data and an open-source implementation."
        },
        {
          "startSeconds": 8.959158268907562,
          "endSeconds": 11.67214281512605,
          "text": "The repository holds the code, the plan and"
        },
        {
          "startSeconds": 11.67214281512605,
          "endSeconds": 14.385127361344537,
          "text": "the recording notes, including the fixtures"
        },
        {
          "startSeconds": 14.385127361344537,
          "endSeconds": 15.016053999999999,
          "text": "used here."
        }
      ]
    }
  ]
}
