{
  "schemaVersion": 1,
  "scenes": [
    {
      "sceneId": "S01",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 1.892,
          "text": "A volunteer spends an hour mentoring a"
        },
        {
          "startSeconds": 1.95,
          "endSeconds": 2.577,
          "text": "child."
        },
        {
          "startSeconds": 3.042,
          "endSeconds": 5.283,
          "text": "Before she leaves, she learns the family"
        },
        {
          "startSeconds": 5.341,
          "endSeconds": 7.964,
          "text": "needs diapers tonight, so she posts a brief"
        },
        {
          "startSeconds": 8.022,
          "endSeconds": 8.615,
          "text": "update."
        },
        {
          "startSeconds": 9.358,
          "endSeconds": 11.331,
          "text": "By morning it is buried under dozens of"
        },
        {
          "startSeconds": 11.389,
          "endSeconds": 12.156,
          "text": "messages."
        },
        {
          "startSeconds": 12.562,
          "endSeconds": 14.222,
          "text": "The hour may never be counted."
        },
        {
          "startSeconds": 14.768,
          "endSeconds": 16.625,
          "text": "The family may still be waiting."
        }
      ]
    },
    {
      "sceneId": "S02",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.299,
          "text": "This is the problem behind challenge five:"
        },
        {
          "startSeconds": 2.647,
          "endSeconds": 5.074,
          "text": "coordinators rebuild their week from chats,"
        },
        {
          "startSeconds": 5.178,
          "endSeconds": 8.905,
          "text": "texts and photos — forty volunteers, four"
        },
        {
          "startSeconds": 8.951,
          "endSeconds": 10.704,
          "text": "hours a week, by hand."
        },
        {
          "startSeconds": 11.447,
          "endSeconds": 13.584,
          "text": "Volunteer Relay turns those updates into"
        },
        {
          "startSeconds": 13.642,
          "endSeconds": 16.382,
          "text": "traceable records, and needs someone owns."
        },
        {
          "startSeconds": 17.125,
          "endSeconds": 19.656,
          "text": "Here is the coordinator's inbox, with review"
        },
        {
          "startSeconds": 19.702,
          "endSeconds": 20.619,
          "text": "work waiting."
        }
      ]
    },
    {
      "sceneId": "S03",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.159,
          "text": "Volunteers report in their own words."
        },
        {
          "startSeconds": 2.902,
          "endSeconds": 4.934,
          "text": "This update describes one shared garden"
        },
        {
          "startSeconds": 4.969,
          "endSeconds": 7.767,
          "text": "visit, two volunteers, and the time each of"
        },
        {
          "startSeconds": 7.814,
          "endSeconds": 8.545,
          "text": "them gave."
        },
        {
          "startSeconds": 9.288,
          "endSeconds": 11.308,
          "text": "Relay proposes an activity and two"
        },
        {
          "startSeconds": 11.366,
          "endSeconds": 13.804,
          "text": "contributions, and keeps every proposed"
        },
        {
          "startSeconds": 13.862,
          "endSeconds": 15.778,
          "text": "field tied to the original message."
        },
        {
          "startSeconds": 16.521,
          "endSeconds": 19.18,
          "text": "Nothing is approved until staff decide."
        }
      ]
    },
    {
      "sceneId": "S04",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.194,
          "text": "One message holds a visit for two people."
        },
        {
          "startSeconds": 2.937,
          "endSeconds": 5.097,
          "text": "One shared hour means one visit and two"
        },
        {
          "startSeconds": 5.155,
          "endSeconds": 7.953,
          "text": "volunteer-hours, so approving it records two"
        },
        {
          "startSeconds": 8.057,
          "endSeconds": 10.043,
          "text": "separate contributions of sixty minutes"
        },
        {
          "startSeconds": 10.089,
          "endSeconds": 10.519,
          "text": "each."
        },
        {
          "startSeconds": 11.389,
          "endSeconds": 13.56,
          "text": "Staff can inspect the evidence first, and"
        },
        {
          "startSeconds": 13.642,
          "endSeconds": 16.602,
          "text": "anything missing or unresolved stays visible"
        },
        {
          "startSeconds": 16.718,
          "endSeconds": 17.867,
          "text": "instead of being guessed."
        },
        {
          "startSeconds": 18.088,
          "endSeconds": 19.179,
          "text": "Nothing is guessed."
        }
      ]
    },
    {
      "sceneId": "S05",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.38,
          "text": "A later update describes the same visit."
        },
        {
          "startSeconds": 3.123,
          "endSeconds": 5.248,
          "text": "Counting every message would inflate the"
        },
        {
          "startSeconds": 5.294,
          "endSeconds": 7.767,
          "text": "totals, so Relay raises the possible"
        },
        {
          "startSeconds": 7.802,
          "endSeconds": 9.276,
          "text": "duplicate for staff review."
        },
        {
          "startSeconds": 10.286,
          "endSeconds": 12.434,
          "text": "Rejecting it leaves the approved ledger"
        },
        {
          "startSeconds": 12.539,
          "endSeconds": 14.826,
          "text": "unchanged, and the decision stays attached"
        },
        {
          "startSeconds": 14.861,
          "endSeconds": 15.836,
          "text": "to its source."
        }
      ]
    },
    {
      "sceneId": "S06",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.206,
          "text": "An urgent need should never wait on a buried"
        },
        {
          "startSeconds": 2.241,
          "endSeconds": 2.891,
          "text": "message."
        },
        {
          "startSeconds": 3.437,
          "endSeconds": 6.142,
          "text": "Staff assign an owner, set an acknowledgment"
        },
        {
          "startSeconds": 6.2,
          "endSeconds": 9.16,
          "text": "deadline, and later record the outcome."
        },
        {
          "startSeconds": 9.903,
          "endSeconds": 12.121,
          "text": "If acknowledgment stalls, the worker"
        },
        {
          "startSeconds": 12.202,
          "endSeconds": 13.642,
          "text": "escalates at the deadline."
        },
        {
          "startSeconds": 14.826,
          "endSeconds": 17.496,
          "text": "Delivery is not acknowledgment, and the"
        },
        {
          "startSeconds": 17.554,
          "endSeconds": 19.597,
          "text": "board shows what still needs attention."
        },
        {
          "startSeconds": 20.468,
          "endSeconds": 22.848,
          "text": "Acknowledgment is a person, not a delivery"
        },
        {
          "startSeconds": 22.906,
          "endSeconds": 23.638,
          "text": "receipt."
        }
      ]
    },
    {
      "sceneId": "S07",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.38,
          "text": "At the end of the week the report comes from"
        },
        {
          "startSeconds": 2.426,
          "endSeconds": 4.342,
          "text": "the same records the team used to do its"
        },
        {
          "startSeconds": 4.377,
          "endSeconds": 4.818,
          "text": "work."
        },
        {
          "startSeconds": 5.457,
          "endSeconds": 8.696,
          "text": "Approved hours, contributions, open needs"
        },
        {
          "startSeconds": 8.742,
          "endSeconds": 11.157,
          "text": "and pending items are counted consistently,"
        },
        {
          "startSeconds": 11.622,
          "endSeconds": 13.967,
          "text": "and unknown time stays unknown rather than"
        },
        {
          "startSeconds": 14.013,
          "endSeconds": 15.035,
          "text": "becoming zero."
        },
        {
          "startSeconds": 15.906,
          "endSeconds": 17.995,
          "text": "Every decision is kept in an audit history"
        },
        {
          "startSeconds": 18.03,
          "endSeconds": 20.468,
          "text": "with its source, so report and work share"
        },
        {
          "startSeconds": 20.526,
          "endSeconds": 21.362,
          "text": "one source."
        }
      ]
    },
    {
      "sceneId": "S08",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 1.115,
          "text": "Volunteer Relay."
        },
        {
          "startSeconds": 1.753,
          "endSeconds": 4.946,
          "text": "Every hour counted, every need connected."
        },
        {
          "startSeconds": 5.584,
          "endSeconds": 7.906,
          "text": "Built for nonprofit teams, with fictional"
        },
        {
          "startSeconds": 7.976,
          "endSeconds": 10.913,
          "text": "demo data and an open-source implementation."
        },
        {
          "startSeconds": 11.784,
          "endSeconds": 14.64,
          "text": "The repository holds the code, the plan and"
        },
        {
          "startSeconds": 14.721,
          "endSeconds": 15.929,
          "text": "the recording notes."
        }
      ]
    }
  ]
}
