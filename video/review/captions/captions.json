{
  "schemaVersion": 1,
  "scenes": [
    {
      "sceneId": "S01",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.067,
          "text": "A volunteer spends an hour mentoring a"
        },
        {
          "startSeconds": 2.125,
          "endSeconds": 2.844,
          "text": "child."
        },
        {
          "startSeconds": 3.541,
          "endSeconds": 5.735,
          "text": "Before she leaves, she learns the family"
        },
        {
          "startSeconds": 5.793,
          "endSeconds": 8.603,
          "text": "needs diapers tonight, so she posts a brief"
        },
        {
          "startSeconds": 8.673,
          "endSeconds": 9.311,
          "text": "update."
        },
        {
          "startSeconds": 10.124,
          "endSeconds": 12.411,
          "text": "By morning it is buried under dozens of"
        },
        {
          "startSeconds": 12.469,
          "endSeconds": 13.282,
          "text": "messages."
        },
        {
          "startSeconds": 14.234,
          "endSeconds": 16.115,
          "text": "The hour may never be counted."
        },
        {
          "startSeconds": 16.625,
          "endSeconds": 18.669,
          "text": "The family may still be waiting."
        }
      ]
    },
    {
      "sceneId": "S02",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.473,
          "text": "This is the problem behind challenge five:"
        },
        {
          "startSeconds": 2.856,
          "endSeconds": 5.492,
          "text": "coordinators rebuild their week from chats,"
        },
        {
          "startSeconds": 5.608,
          "endSeconds": 9.056,
          "text": "texts and photos — forty volunteers, four"
        },
        {
          "startSeconds": 9.102,
          "endSeconds": 11.018,
          "text": "hours a week, by hand."
        },
        {
          "startSeconds": 11.831,
          "endSeconds": 14.454,
          "text": "Volunteer Relay turns those updates into"
        },
        {
          "startSeconds": 14.512,
          "endSeconds": 17.519,
          "text": "traceable records, and needs someone owns."
        },
        {
          "startSeconds": 18.471,
          "endSeconds": 20.991,
          "text": "Here is the coordinator's inbox, with review"
        },
        {
          "startSeconds": 21.037,
          "endSeconds": 22.013,
          "text": "work waiting."
        }
      ]
    },
    {
      "sceneId": "S03",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.368,
          "text": "Volunteers report in their own words."
        },
        {
          "startSeconds": 3.065,
          "endSeconds": 5.166,
          "text": "This update describes one shared garden"
        },
        {
          "startSeconds": 5.201,
          "endSeconds": 8.081,
          "text": "visit, two volunteers, and the time each of"
        },
        {
          "startSeconds": 8.127,
          "endSeconds": 8.928,
          "text": "them gave."
        },
        {
          "startSeconds": 9.741,
          "endSeconds": 11.912,
          "text": "Relay proposes an activity and two"
        },
        {
          "startSeconds": 11.981,
          "endSeconds": 14.71,
          "text": "contributions, and keeps every proposed"
        },
        {
          "startSeconds": 14.756,
          "endSeconds": 16.788,
          "text": "field tied to the original message."
        },
        {
          "startSeconds": 17.74,
          "endSeconds": 20.619,
          "text": "Nothing is approved until staff decide."
        }
      ]
    },
    {
      "sceneId": "S04",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.45,
          "text": "One message holds a visit for two people."
        },
        {
          "startSeconds": 3.262,
          "endSeconds": 6.49,
          "text": "One shared hour means one visit and two"
        },
        {
          "startSeconds": 6.583,
          "endSeconds": 9.868,
          "text": "volunteer-hours, so approving it records two"
        },
        {
          "startSeconds": 9.95,
          "endSeconds": 12.132,
          "text": "separate contributions of sixty minutes"
        },
        {
          "startSeconds": 12.202,
          "endSeconds": 12.701,
          "text": "each."
        },
        {
          "startSeconds": 13.514,
          "endSeconds": 16.649,
          "text": "Staff can inspect the evidence first, and"
        },
        {
          "startSeconds": 16.742,
          "endSeconds": 20.143,
          "text": "anything missing or unresolved stays visible"
        },
        {
          "startSeconds": 20.352,
          "endSeconds": 21.629,
          "text": "instead of being guessed."
        },
        {
          "startSeconds": 21.908,
          "endSeconds": 23.127,
          "text": "Nothing is guessed."
        }
      ]
    },
    {
      "sceneId": "S05",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.438,
          "text": "A later update describes the same visit."
        },
        {
          "startSeconds": 3.39,
          "endSeconds": 5.642,
          "text": "Counting every message would inflate the"
        },
        {
          "startSeconds": 5.689,
          "endSeconds": 8.533,
          "text": "totals, so Relay raises the possible"
        },
        {
          "startSeconds": 8.58,
          "endSeconds": 10.507,
          "text": "duplicate for staff review."
        },
        {
          "startSeconds": 11.459,
          "endSeconds": 13.653,
          "text": "Rejecting it leaves the approved ledger"
        },
        {
          "startSeconds": 13.769,
          "endSeconds": 16.707,
          "text": "unchanged, and the decision stays attached"
        },
        {
          "startSeconds": 16.788,
          "endSeconds": 17.879,
          "text": "to its source."
        }
      ]
    },
    {
      "sceneId": "S06",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.415,
          "text": "An urgent need should never wait on a buried"
        },
        {
          "startSeconds": 2.461,
          "endSeconds": 3.17,
          "text": "message."
        },
        {
          "startSeconds": 4.122,
          "endSeconds": 6.769,
          "text": "Staff assign an owner, set an acknowledgment"
        },
        {
          "startSeconds": 6.815,
          "endSeconds": 9.3,
          "text": "deadline, and later record the outcome."
        },
        {
          "startSeconds": 10.252,
          "endSeconds": 12.562,
          "text": "If acknowledgment stalls, the worker"
        },
        {
          "startSeconds": 12.655,
          "endSeconds": 14.187,
          "text": "escalates at the deadline."
        },
        {
          "startSeconds": 15.139,
          "endSeconds": 17.786,
          "text": "Delivery is not acknowledgment, and the"
        },
        {
          "startSeconds": 17.844,
          "endSeconds": 19.911,
          "text": "board shows what still needs attention."
        },
        {
          "startSeconds": 20.724,
          "endSeconds": 23.44,
          "text": "Acknowledgment is a person, not a delivery"
        },
        {
          "startSeconds": 23.51,
          "endSeconds": 24.288,
          "text": "receipt."
        }
      ]
    },
    {
      "sceneId": "S07",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 2.635,
          "text": "At the end of the week the report comes from"
        },
        {
          "startSeconds": 2.682,
          "endSeconds": 5.19,
          "text": "the same records the team used to do its"
        },
        {
          "startSeconds": 5.236,
          "endSeconds": 5.712,
          "text": "work."
        },
        {
          "startSeconds": 6.664,
          "endSeconds": 10.019,
          "text": "Approved hours, contributions, open needs"
        },
        {
          "startSeconds": 10.403,
          "endSeconds": 12.98,
          "text": "and pending items are counted consistently,"
        },
        {
          "startSeconds": 13.491,
          "endSeconds": 16.625,
          "text": "and unknown time stays unknown rather than"
        },
        {
          "startSeconds": 16.671,
          "endSeconds": 17.809,
          "text": "becoming zero."
        },
        {
          "startSeconds": 18.622,
          "endSeconds": 21.06,
          "text": "Every decision is kept in an audit history"
        },
        {
          "startSeconds": 21.106,
          "endSeconds": 23.684,
          "text": "with its source, so report and work share"
        },
        {
          "startSeconds": 23.754,
          "endSeconds": 24.659,
          "text": "one source."
        }
      ]
    },
    {
      "sceneId": "S08",
      "derived": "alignment",
      "cues": [
        {
          "startSeconds": 0,
          "endSeconds": 1.265,
          "text": "Volunteer Relay."
        },
        {
          "startSeconds": 1.962,
          "endSeconds": 5.41,
          "text": "Every hour counted, every need connected."
        },
        {
          "startSeconds": 6.223,
          "endSeconds": 8.893,
          "text": "Built for nonprofit teams, with fictional"
        },
        {
          "startSeconds": 9.009,
          "endSeconds": 12.214,
          "text": "demo data and an open-source implementation."
        },
        {
          "startSeconds": 13.026,
          "endSeconds": 16.451,
          "text": "The repository holds the code, the plan and"
        },
        {
          "startSeconds": 16.486,
          "endSeconds": 17.74,
          "text": "the recording notes."
        }
      ]
    }
  ]
}
