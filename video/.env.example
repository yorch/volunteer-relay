# Copy to video/.env.local (ignored) and fill in locally. Never commit values.
# Exported process variables take precedence over this file.

# Capture target. Hosted is the default; local is an explicit rehearsal fallback.
VIDEO_BASE_URL=https://volunteer-relay.brnby.com
VIDEO_TARGET_MODE=hosted
VIDEO_ALLOWED_ORIGIN=https://volunteer-relay.brnby.com

# Organization ids returned by the application (this profile uses literal ids).
VIDEO_ORGANIZATION_ID=tidepath
VIDEO_SECONDARY_ORGANIZATION_ID=harbor
VIDEO_SCENARIO_RUN_ID=video-hackathon-tidepath-2026-11

# Recording identities. Email is the sign-in username.
VIDEO_OPERATOR_EMAIL=relay.operator@example.com
VIDEO_OPERATOR_PASSWORD=
VIDEO_OWEN_EMAIL=relay.owen@example.com
VIDEO_OWEN_PASSWORD=
VIDEO_MARISOL_EMAIL=relay.marisol@example.com
VIDEO_MARISOL_PASSWORD=
VIDEO_SOFIA_EMAIL=relay.sofia@example.com
VIDEO_SOFIA_PASSWORD=
VIDEO_ANA_EMAIL=relay.ana@example.com
VIDEO_ANA_PASSWORD=
VIDEO_BOARD_EMAIL=relay.board@example.com
VIDEO_BOARD_PASSWORD=
VIDEO_CASEY_EMAIL=relay.casey@example.com
VIDEO_CASEY_PASSWORD=

# Narration provider (ElevenLabs). Leave empty to report narration as blocked.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local rehearsal target (VIDEO_TARGET_MODE=local). Start the rehearsal app
# yourself; the video tooling never starts or resets a database on its own.
# VIDEO_BASE_URL=http://127.0.0.1:3300
# VIDEO_ALLOWED_ORIGIN=http://127.0.0.1:3300
# Local preparation refuses to touch a database unless this marker is present
# and matches the recording profile.
# VIDEO_LOCAL_DATABASE_MARKER=relay-video-recording

# Optional music bed; leave empty for narration only.
# VIDEO_MUSIC_FILE=
