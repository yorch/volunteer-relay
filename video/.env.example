# Copy to video/.env.local (git-ignored, chmod 600) and fill in. Never commit values.
# One file serves the video scripts AND the local rehearsal app: export it into
# every shell with  set -a; . video/.env.local; set +a

# --- capture target ---------------------------------------------------------
# Hosted is the default; local is an explicit rehearsal fallback.
VIDEO_BASE_URL=http://127.0.0.1:3300
VIDEO_TARGET_MODE=local
VIDEO_ALLOWED_ORIGIN=http://127.0.0.1:3300

# Organization ids as returned by the application (this profile uses literal ids).
VIDEO_ORGANIZATION_ID=tidepath
VIDEO_SECONDARY_ORGANIZATION_ID=harbor
VIDEO_SCENARIO_RUN_ID=video-hackathon-tidepath-2026-11

# --- local rehearsal app ----------------------------------------------------
# Required by migrate, the demo seed, next dev and the capture scripts.
NODE_ENV=development
APP_URL=http://127.0.0.1:3300
DATABASE_URL=postgres://relay:relay@127.0.0.1:55480/relay_video_recording
ATTACHMENT_ROOT=./.relay-local/video-attachments
# Generate once per database: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Must equal the marker the scripts require; also asserted by video:prepare.
VIDEO_LOCAL_DATABASE_MARKER=relay-video-recording
NEXT_TELEMETRY_DISABLED=1

# --- recording identities ---------------------------------------------------
# Email is the sign-in username. LEAVE EMAILS BLANK: in local mode video:provision
# fills the scenario addresses (demo-*@example.invalid) and never overwrites a
# non-empty value. Hard-coded relay.* addresses are NOT demo identities and will
# not sign in.
# Role mapping is fixed in fixtures/recording-scenario.json:
#   MARISOL = owner · OWEN = coordinator · SOFIA = volunteer ·
#   BOARD = report-reader · CASEY = multi-organization (second tenant)
VIDEO_MARISOL_EMAIL=
VIDEO_MARISOL_PASSWORD=
VIDEO_OWEN_EMAIL=
VIDEO_OWEN_PASSWORD=
VIDEO_SOFIA_EMAIL=
VIDEO_SOFIA_PASSWORD=
VIDEO_BOARD_EMAIL=
VIDEO_BOARD_PASSWORD=
VIDEO_CASEY_EMAIL=
VIDEO_CASEY_PASSWORD=

# Requested but unavailable in the shipped demo profile (left unset on purpose):
# VIDEO_OPERATOR_EMAIL=relay.operator@example.com
# VIDEO_OPERATOR_PASSWORD=
# VIDEO_ANA_EMAIL=relay.ana@example.com
# VIDEO_ANA_PASSWORD=

# --- narration --------------------------------------------------------------
# Leave empty to report narration as blocked. Supplied audio is the alternative:
#   bun run video:voice -- --audio-dir <dir>   (expects S01.mp3 … S08.mp3)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- optional ---------------------------------------------------------------
# Local Chrome/Chromium for Remotion if the automatic download is blocked:
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
# Licensed music bed (never required):
# VIDEO_MUSIC_FILE=
